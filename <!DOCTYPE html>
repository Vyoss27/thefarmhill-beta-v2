<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Farmhill Store | Modern Agrotech & Fresh Store (Semarang & Solo)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Alpine.js & Lucide Icons -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        farmhill: {
                            olive: '#3E5702',
                            'olive-dark': '#213202',
                            'olive-light': '#587B03',
                            kraft: '#8D7560',
                            'kraft-light': '#D9D0C7',
                            gourd: '#FC6720',
                            cream: '#F4F6F0',
                            charcoal: '#2B3624'
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="bg-white text-farmhill-charcoal font-sans antialiased selection:bg-farmhill-olive selection:text-white"
      x-data="farmhillApp()">

    <!-- TOP ANNOUNCEMENT BAR -->
    <div class="bg-farmhill-olive-dark text-white text-xs font-medium py-2.5 px-4 text-center">
        <div class="container mx-auto flex justify-between items-center">
            <span>🌱 <strong>PT Kebun Bumi Lestari:</strong> Dipanen Segar Setiap Hari dari Greenhouse Bandungan & Karanganyar</span>
            <div class="hidden md:flex items-center space-x-4">
                <span>Cabang Aktif: <strong x-text="selectedHub + ' Hub'" class="text-farmhill-gourd uppercase">Semarang Hub</strong></span>
                <span>•</span>
                <span class="text-emerald-300">⚡ Free Delivery & Garansi Retur</span>
            </div>
        </div>
    </div>

    <!-- MAIN NAVBAR -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-sm">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                
                <!-- Logo -->
                <div class="flex-shrink-0 flex items-center space-x-3 cursor-pointer" @click="activeCategory = 'ALL'">
                    <div class="w-10 h-10 bg-farmhill-olive rounded-xl flex items-center justify-center text-white font-extrabold text-xl shadow-md">
                        FH
                    </div>
                    <div>
                        <span class="text-xl font-extrabold tracking-tight text-farmhill-olive-dark block leading-none">THE FARMHILL</span>
                        <span class="text-[9px] tracking-widest text-farmhill-kraft uppercase font-bold">Direct Selling Store</span>
                    </div>
                </div>

                <!-- Navigation Categories -->
                <nav class="hidden lg:flex space-x-1 bg-farmhill-cream p-1.5 rounded-2xl border border-farmhill-olive/10">
                    <button @click="activeCategory = 'ALL'" :class="activeCategory === 'ALL' ? 'bg-farmhill-olive text-white shadow-sm' : 'text-gray-600 hover:text-farmhill-olive'" class="px-4 py-2 rounded-xl text-xs font-bold transition-all">
                        Semua Produk
                    </button>
                    <button @click="activeCategory = 'PROMO'" :class="activeCategory === 'PROMO' ? 'bg-farmhill-gourd text-white shadow-sm' : 'text-gray-600 hover:text-farmhill-olive'" class="px-4 py-2 rounded-xl text-xs font-bold transition-all">
                        🔥 Pay Day Sale
                    </button>
                    <button @click="activeCategory = 'MELON'" :class="activeCategory === 'MELON' ? 'bg-farmhill-olive text-white shadow-sm' : 'text-gray-600 hover:text-farmhill-olive'" class="px-4 py-2 rounded-xl text-xs font-bold transition-all">
                        🍈 Melon Hydroponic
                    </button>
                    <button @click="activeCategory = 'FRUIT'" :class="activeCategory === 'FRUIT' ? 'bg-farmhill-olive text-white shadow-sm' : 'text-gray-600 hover:text-farmhill-olive'" class="px-4 py-2 rounded-xl text-xs font-bold transition-all">
                        🍇 Buah Segar
                    </button>
                    <button @click="activeCategory = 'SALAD_JUICE'" :class="activeCategory === 'SALAD_JUICE' ? 'bg-farmhill-olive text-white shadow-sm' : 'text-gray-600 hover:text-farmhill-olive'" class="px-4 py-2 rounded-xl text-xs font-bold transition-all">
                        🩵 Salad & Jus
                    </button>
                    <button @click="activeCategory = 'FROZEN'" :class="activeCategory === 'FROZEN' ? 'bg-farmhill-olive text-white shadow-sm' : 'text-gray-600 hover:text-farmhill-olive'" class="px-4 py-2 rounded-xl text-xs font-bold transition-all">
                        🍟 Frozen Food
                    </button>
                </nav>

                <!-- Action Controls -->
                <div class="flex items-center space-x-3">
                    
                    <!-- Hub Switcher Dropdown -->
                    <div class="relative" x-data="{ open: false }">
                        <button @click="open = !open" class="flex items-center space-x-2 bg-farmhill-cream border border-farmhill-olive/20 text-farmhill-olive px-3.5 py-2 rounded-xl text-xs font-bold hover:bg-farmhill-olive hover:text-white transition-all">
                            <i data-lucide="map-pin" class="w-4 h-4"></i>
                            <span x-text="selectedHub">Semarang</span>
                            <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
                        </button>
                        <div x-show="open" @click.outside="open = false" x-cloak class="absolute right-0 mt-2 w-52 bg-white rounded-2xl shadow-2xl border border-gray-100 py-2 z-50">
                            <div class="px-4 py-1.5 text-[10px] uppercase tracking-wider text-gray-400 font-extrabold">Pilih Cabang Pengiriman</div>
                            <button @click="setHub('Semarang'); open = false" class="w-full text-left px-4 py-2.5 text-xs hover:bg-farmhill-cream flex items-center justify-between font-bold">
                                <span>Semarang Hub</span>
                                <i x-show="selectedHub === 'Semarang'" data-lucide="check" class="w-4 h-4 text-farmhill-olive"></i>
                            </button>
                            <button @click="setHub('Solo'); open = false" class="w-full text-left px-4 py-2.5 text-xs hover:bg-farmhill-cream flex items-center justify-between font-bold">
                                <span>Solo Hub</span>
                                <i x-show="selectedHub === 'Solo'" data-lucide="check" class="w-4 h-4 text-farmhill-olive"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Shopping Cart Trigger -->
                    <button @click="isCartOpen = true" class="relative bg-farmhill-olive text-white p-2.5 rounded-xl hover:bg-farmhill-olive-dark transition-all shadow-md">
                        <i data-lucide="shopping-bag" class="w-5 h-5"></i>
                        <span x-show="cart.length > 0" x-text="cart.reduce((total, item) => total + item.qty, 0)" class="absolute -top-1.5 -right-1.5 w-5 h-5 bg-farmhill-gourd text-white text-[10px] font-black rounded-full flex items-center justify-center border-2 border-white">0</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- HERO BANNER SECTION -->
    <section class="relative bg-farmhill-cream py-12 lg:py-16 border-b border-gray-100">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-12 gap-8 items-center">
                
                <div class="lg:col-span-7 space-y-5">
                    <div class="inline-flex items-center space-x-2 bg-white px-3.5 py-1.5 rounded-full border border-farmhill-olive/20 text-farmhill-olive text-xs font-bold">
                        <span class="w-2 h-2 rounded-full bg-farmhill-gourd animate-ping"></span>
                        <span>Official Direct Selling Store — PT Kebun Bumi Lestari</span>
                    </div>
                    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-farmhill-olive-dark tracking-tight leading-tight">
                        Siap Antar Melon & Buah Segar <span class="text-farmhill-gourd">Langsung ke Rumahmu! 🚀</span>
                    </h1>
                    <p class="text-gray-600 text-sm sm:text-base leading-relaxed max-w-2xl">
                        Nikmati sensasi manis renyah melon premium hasil panen greenhouse hidroponik serta aneka buah segar, salad, dan frozen food pilihan. Dapatkan garansi retur & gratis ongkir area Semarang & Solo.
                    </p>
                    
                    <div class="flex flex-wrap gap-4 pt-2">
                        <div class="flex items-center space-x-2 text-xs font-bold bg-white px-4 py-2.5 rounded-xl border border-gray-100 shadow-sm">
                            <i data-lucide="truck" class="w-4 h-4 text-farmhill-olive"></i>
                            <span>Free Delivery</span>
                        </div>
                        <div class="flex items-center space-x-2 text-xs font-bold bg-white px-4 py-2.5 rounded-xl border border-gray-100 shadow-sm">
                            <i data-lucide="shield-check" class="w-4 h-4 text-farmhill-olive"></i>
                            <span>Garansi Retur Produk</span>
                        </div>
                        <div class="flex items-center space-x-2 text-xs font-bold bg-white px-4 py-2.5 rounded-xl border border-gray-100 shadow-sm">
                            <i data-lucide="sparkles" class="w-4 h-4 text-farmhill-gourd"></i>
                            <span>Kualitas Juara Harga Bersaing</span>
                        </div>
                    </div>
                </div>

                <!-- Featured Promo Box -->
                <div class="lg:col-span-5">
                    <div class="bg-gradient-to-br from-farmhill-olive to-farmhill-olive-dark rounded-3xl p-6 text-white shadow-xl relative overflow-hidden">
                        <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-white/10 rounded-full blur-2xl"></div>
                        <span class="bg-farmhill-gourd text-white text-[10px] font-black uppercase px-3 py-1 rounded-full tracking-wider">PROMO PAY DAY SALE</span>
                        <h3 class="text-2xl font-extrabold mt-3">Bundling Hemat Panen Raya 🍈</h3>
                        <p class="text-xs text-emerald-100 mt-1">Stok promo sangat terbatas untuk pengiriman hari ini!</p>
                        
                        <div class="mt-4 space-y-3">
                            <div class="bg-white/10 backdrop-blur-md rounded-2xl p-3 flex justify-between items-center border border-white/10">
                                <div>
                                    <div class="text-xs font-bold">Melon Elysia + Kelengkeng Bangkok</div>
                                    <div class="text-[10px] text-emerald-200">1 Buah Melon + 500g Kelengkeng</div>
                                </div>
                                <div class="text-right">
                                    <div class="text-sm font-black text-amber-300">Rp 75.000</div>
                                    <button @click="addToCart({id: 101, name: 'Promo: Melon Elysia + Kelengkeng Bangkok', price: 75000, category: 'PROMO', weight: '1 Paket'})" class="mt-1 bg-farmhill-gourd text-white text-[10px] font-bold px-2.5 py-1 rounded-lg hover:bg-orange-600 transition-all">+ Ambil Promo</button>
                                </div>
                            </div>
                            <div class="bg-white/10 backdrop-blur-md rounded-2xl p-3 flex justify-between items-center border border-white/10">
                                <div>
                                    <div class="text-xs font-bold">Melon Elysia (2 Buah)</div>
                                    <div class="text-[10px] text-emerald-200">2 Buah Melon Fresh Harvest</div>
                                </div>
                                <div class="text-right">
                                    <div class="text-sm font-black text-amber-300">Rp 85.000</div>
                                    <button @click="addToCart({id: 102, name: 'Promo: Melon Elysia 2 Buah', price: 85000, category: 'PROMO', weight: '2 Buah'})" class="mt-1 bg-farmhill-gourd text-white text-[10px] font-bold px-2.5 py-1 rounded-lg hover:bg-orange-600 transition-all">+ Ambil Promo</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- PRODUCT CATALOG SECTION -->
    <section class="py-12 bg-white">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4 border-b border-gray-100 pb-6">
                <div>
                    <span class="text-xs font-extrabold text-farmhill-gourd tracking-widest uppercase">Katalog Ready Stock Hari Ini</span>
                    <h2 class="text-2xl font-extrabold text-farmhill-olive-dark mt-0.5">Produk Segar Siap Kirim</h2>
                </div>
                
                <div class="flex items-center space-x-3">
                    <span class="text-xs font-semibold text-gray-500">Filter Stok:</span>
                    <select x-model="stockFilter" class="bg-farmhill-cream border border-gray-200 text-xs font-bold rounded-xl px-3 py-2 text-farmhill-charcoal focus:outline-none focus:ring-2 focus:ring-farmhill-olive">
                        <option value="ALL">Semua Stok</option>
                        <option value="TERSEDIA">Tersedia</option>
                        <option value="MENIPIS">Stok Menipis 🔥</option>
                    </select>
                </div>
            </div>

            <!-- PRODUCT GRID -->
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <template x-for="product in filteredProducts" :key="product.id">
                    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between overflow-hidden group p-4 border border-gray-100 relative">
                        
                        <!-- Badges -->
                        <div class="flex justify-between items-start mb-3">
                            <span class="bg-farmhill-cream text-farmhill-olive text-[10px] font-black uppercase px-2.5 py-1 rounded-lg border border-farmhill-olive/10" x-text="product.category"></span>
                            
                            <!-- Stock Status Badge -->
                            <span :class="{
                                'bg-emerald-100 text-emerald-800 border-emerald-200': product.status === 'TERSEDIA',
                                'bg-amber-100 text-amber-800 border-amber-200': product.status === 'MENIPIS',
                                'bg-rose-100 text-rose-800 border-rose-200': product.status === 'HABIS'
                            }" class="text-[10px] font-bold px-2 py-0.5 rounded-md border flex items-center space-x-1">
                                <span class="w-1.5 h-1.5 rounded-full" :class="{
                                    'bg-emerald-500': product.status === 'TERSEDIA',
                                    'bg-amber-500 animate-pulse': product.status === 'MENIPIS',
                                    'bg-rose-500': product.status === 'HABIS'
                                }"></span>
                                <span x-text="product.status === 'MENIPIS' ? 'Stok Menipis (' + product.stock + ')' : product.status"></span>
                            </span>
                        </div>

                        <!-- Product Content -->
                        <div class="my-2">
                            <h3 class="font-bold text-gray-800 text-base group-hover:text-farmhill-olive transition-colors leading-snug" x-text="product.name"></h3>
                            <div class="text-xs text-gray-400 mt-1 flex items-center space-x-2">
                                <i data-lucide="package" class="w-3.5 h-3.5"></i>
                                <span x-text="product.weight"></span>
                            </div>
                        </div>

                        <!-- Price & Action -->
                        <div class="mt-4 pt-3 border-t border-gray-50 flex items-center justify-between">
                            <div>
                                <span class="text-[10px] text-gray-400 block font-semibold">Harga Hari Ini</span>
                                <span class="text-base font-extrabold text-farmhill-olive-dark" x-text="formatRupiah(product.price)"></span>
                            </div>
                            
                            <button @click="addToCart(product)" 
                                    :disabled="product.status === 'HABIS'"
                                    :class="product.status === 'HABIS' ? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-farmhill-olive hover:bg-farmhill-olive-dark text-white shadow-md'"
                                    class="px-3 py-2 rounded-xl text-xs font-bold flex items-center space-x-1.5 transition-all">
                                <i data-lucide="plus" class="w-4 h-4"></i>
                                <span>Beli</span>
                            </button>
                        </div>

                    </div>
                </template>
            </div>

        </div>
    </section>

    <!-- SHOPPING CART DRAWER -->
    <div x-show="isCartOpen" x-cloak class="relative z-50">
        <div x-show="isCartOpen" x-transition.opacity class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm" @click="isCartOpen = false"></div>
        <div class="fixed inset-0 overflow-hidden pointer-events-none">
            <div class="absolute inset-0 overflow-hidden">
                <div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10">
                    <div x-show="isCartOpen" x-transition:enter="transform transition ease-in-out duration-300" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0" x-transition:leave="transform transition ease-in-out duration-300" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full" class="pointer-events-auto w-screen max-w-md">
                        <div class="flex h-full flex-col bg-white shadow-2xl">
                            
                            <!-- Header -->
                            <div class="p-5 bg-farmhill-cream border-b border-gray-200 flex items-center justify-between">
                                <div>
                                    <h2 class="text-base font-bold text-farmhill-olive-dark">Keranjang Belanja</h2>
                                    <p class="text-xs text-gray-500">Cabang Pengiriman: <span class="font-bold uppercase text-farmhill-olive" x-text="selectedHub + ' Hub'"></span></p>
                                </div>
                                <button @click="isCartOpen = false" class="text-gray-400 hover:text-gray-600 p-1">
                                    <i data-lucide="x" class="w-6 h-6"></i>
                                </button>
                            </div>

                            <!-- Cart Items List -->
                            <div class="flex-1 overflow-y-auto p-5 space-y-4">
                                <template x-for="item in cart" :key="item.id">
                                    <div class="flex items-center justify-between border-b border-gray-100 pb-3">
                                        <div class="flex-1 pr-3">
                                            <h4 class="font-bold text-gray-800 text-xs" x-text="item.name"></h4>
                                            <div class="text-[11px] text-farmhill-olive font-extrabold mt-0.5" x-text="formatRupiah(item.price)"></div>
                                        </div>
                                        <div class="flex items-center space-x-2 bg-gray-50 px-2 py-1 rounded-xl border border-gray-200">
                                            <button @click="updateQty(item.id, -1)" class="w-6 h-6 rounded-lg bg-white shadow-sm flex items-center justify-center text-xs font-bold text-gray-600 hover:text-farmhill-olive">-</button>
                                            <span class="text-xs font-bold px-1" x-text="item.qty"></span>
                                            <button @click="updateQty(item.id, 1)" class="w-6 h-6 rounded-lg bg-white shadow-sm flex items-center justify-center text-xs font-bold text-gray-600 hover:text-farmhill-olive">+</button>
                                        </div>
                                    </div>
                                </template>

                                <div x-show="cart.length === 0" class="text-center py-16 text-gray-400">
                                    <i data-lucide="shopping-bag" class="w-12 h-12 mx-auto mb-3 opacity-20"></i>
                                    <p class="text-xs font-bold">Keranjang belanja Anda masih kosong.</p>
                                </div>
                            </div>

                            <!-- Cart Footer -->
                            <div class="p-5 border-t border-gray-200 bg-gray-50 space-y-3">
                                <div class="flex justify-between items-center text-sm font-extrabold text-gray-900">
                                    <span>Total Pembayaran</span>
                                    <span class="text-lg text-farmhill-olive" x-text="formatRupiah(cartTotal)"></span>
                                </div>
                                
                                <button @click="checkoutWhatsApp()" :disabled="cart.length === 0" class="w-full bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50 text-white font-bold py-3 px-4 rounded-xl flex items-center justify-center space-x-2 transition-all shadow-md">
                                    <i data-lucide="message-square" class="w-4 h-4"></i>
                                    <span class="text-xs">Pesan via WhatsApp Direct</span>
                                </button>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ALPINE.JS APP DATA ENGINE -->
