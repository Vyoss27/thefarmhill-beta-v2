                    { id: 20, name: 'Alpukat Kendil', category: 'FRUIT', weight: 'Per Kg', price: 40000, stock: 8, status: 'TERSEDIA' },
                    { id: 21, name: 'Mangga Harumanis Tua Pohon', category: 'FRUIT', weight: 'Per Kg', price: 35000, stock: 10, status: 'TERSEDIA' },
                    { id: 22, name: 'Kiwi Gold Import', category: 'FRUIT', weight: 'Pack isi 5 Buah', price: 46000, stock: 6, status: 'TERSEDIA' },
                    { id: 23, name: 'Nanas Honi Manis', category: 'FRUIT', weight: 'Per Buah', price: 25000, stock: 11, status: 'TERSEDIA' },

                    // FROZEN
                    { id: 24, name: 'Frozen Durian Montong Palu', category: 'FROZEN', weight: '-+ 500 Gram', price: 95000, stock: 5, status: 'TERSEDIA' },
                    { id: 25, name: 'Frozen Pancake Durian', category: 'FROZEN', weight: 'Pack isi 8 Pcs', price: 15000, stock: 16, status: 'TERSEDIA' },
                    { id: 26, name: 'Kentang Frozen Super', category: 'FROZEN', weight: '-+ 500 Gram', price: 20000, stock: 20, status: 'TERSEDIA' },
                    { id: 27, name: 'Frozen Sweet Corn Pipil', category: 'FROZEN', weight: '-+ 500 Gram', price: 19000, stock: 15, status: 'TERSEDIA' }
                ],
                get filteredProducts() {
                    return this.products.filter(p => {
                        const matchCat = (this.activeCategory === 'ALL' || p.category === this.activeCategory);
                        const matchStock = (this.stockFilter === 'ALL' || p.status === this.stockFilter);
                        return matchCat && matchStock;
                    });
                },
                setHub(hub) {
                    this.selectedHub = hub;
                },
                addToCart(product) {
                    const existing = this.cart.find(i => i.id === product.id);
                    if (existing) {
                        existing.qty++;
                    } else {
                        this.cart.push({ ...product, qty: 1 });
                    }
                    this.isCartOpen = true;
                },
                updateQty(id, delta) {
                    const item = this.cart.find(i => i.id === id);
                    if (item) {
                        item.qty += delta;
                        if (item.qty <= 0) {
                            this.cart = this.cart.filter(i => i.id !== id);
                        }
                    }
                },
                get cartTotal() {
                    return this.cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
                },
                formatRupiah(amount) {
                    return 'Rp ' + amount.toLocaleString('id-ID');
                },
                checkoutWhatsApp() {
                    const phone = '6281234567890';
                    let text = `*Pesanan Baru - The Farmhill Store (${this.selectedHub} Hub)*

`;
                    this.cart.forEach(item => {
                        text += `• ${item.name} x${item.qty} = ${this.formatRupiah(item.price * item.qty)}
`;
                    });
                    text += `
*Total Pembayaran:* ${this.formatRupiah(this.cartTotal)}`;
                    text += `
*Cabang Pengiriman:* ${this.selectedHub} Hub`;
                    text += `

Mohon diproses pesanan saya ya, terima kasih!`;
                    
                    const url = `https://wa.me/${phone}?text=${encodeURIComponent(text)}`;
                    window.open(url, '_blank');
                }
            }
        }
